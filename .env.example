# Copy to .env.local and fill in. Never commit .env.local.

# Supabase (Project Settings > API). EU region.
NEXT_PUBLIC_SUPABASE_URL=https://dlyxwupqucwiglrdrnho.supabase.co
# Public "anon" / publishable key: safe in the browser, protected by RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secret: bypasses RLS. Server only.
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic (phase 3). Server only.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
# AI additions per user per month, reset on the 1st.
AI_MONTHLY_QUOTA=10

# Web Push (phase 4). Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Public URL of the site, without trailing slash (share links, OG images).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
