# Copy to .env.local and fill in. Never commit .env.local.

# Supabase (Project Settings > API). EU region.
NEXT_PUBLIC_SUPABASE_URL=https://dlyxwupqucwiglrdrnho.supabase.co
# Public "anon" / publishable key: safe in the browser, protected by RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secret: bypasses RLS. Server only.
SUPABASE_SERVICE_ROLE_KEY=

# AI (phase 3): users' own subscriptions, Popote holds no provider API key.
# "Sign in with ChatGPT" OAuth app (once OpenAI grants plan-usage access).
OPENAI_CLIENT_ID=
OPENAI_CLIENT_SECRET=
OPENAI_MODEL=gpt-6.1-sol
# Encrypts users' ChatGPT OAuth tokens at rest (32 random bytes, base64). Server only.
# Generate with: openssl rand -base64 32
AI_TOKENS_ENCRYPTION_KEY=
# Development only: simulated AI so the add-recipe flow works without a connected AI.
# Never set on Netlify (ignored in production builds unless E2E_ALLOW_FAKE_AI=1).
AI_FAKE_PROVIDER=1

# Web Push (phase 4). Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Public URL of the site, without trailing slash (share links, OG images).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
